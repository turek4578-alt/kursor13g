# Session cookie signing secret. Generate a random string and set a real
# value in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-in-production-please

# Password for the auto-seeded admin@kurs.app account, created on first run.
# Set this BEFORE the first deploy — it's only read the moment the admin row
# is created. Change the admin password afterwards through the app itself.
ADMIN_SEED_PASSWORD=kurs-admin-2026

# --- Database ---
# Leave both blank to use a local SQLite file at ./data/kurs.db (fine for a
# VPS or local dev — the file persists on disk between requests).
#
# For Vercel (or any host without a persistent writable disk), create a free
# database at https://turso.tech and set both of these — the same code then
# talks to Turso instead of a local file:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Real blockchain deposit checking (USDT / TRC20 only, for now) ---
# Not required to run the app; only used by /api/wallets/check-deposit.
# Optional: raises TronGrid's rate limit above the free anonymous tier.
# Get one free at https://www.trongrid.io (developer account).
# TRON_PRO_API_KEY=
